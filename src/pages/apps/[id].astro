---
// One app. All screenshots share one static frame on the paper mat: hidden radio buttons pick the
// capture (the thumbnails are their labels), the image cross-fades inside the frame, and the frame
// morphs between window, phone and bare as the picked capture requires. No JS needed; the arrow
// keys are a courtesy.
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { getApps, pageHref, pageOf, fmtDate, fmtCreated, host, visits, alsoLinks, nameParts, embedFor, type App } from '../../lib/apps';

export async function getStaticPaths() {
  const apps = await getApps();
  return apps.map((app, i) => ({
    params: { id: app.id },
    props: { app, newer: apps[i - 1], older: apps[i + 1], total: apps.length },
  }));
}

interface Props {
  app: App;
  newer?: App;
  older?: App;
  total: number;
}
const { app, newer, older, total } = Astro.props;
const { shots } = app;
const many = shots.length > 1;
const pickId = (j: number) => `pick-${j + 1}`;
const buttons = visits(app); // `url`, plus any store listing among the links
const also = alsoLinks(app);
// the window frame takes the shape of the app's own browser captures (the first landscape one), so a
// Retina capture isn't cropped to 16:10; clamped so an odd capture can't make the frame a strip or a square
const ratio = (s: (typeof shots)[number]) => Math.min(2, Math.max(4 / 3, s.image.width / s.image.height));
const wide = shots.find((s) => !s.tall);
const shot = wide ? ratio(wide) : 1.6; // the first landscape capture sizes the stage
// a capture within 5% of the stage's shape uses the stage's shape (hand-taken Retina captures vary by a line or two, and a
// frame that resizes between them is distracting; the cover's object-fit: cover absorbs the sliver). A real difference
// (a 16:10 capture next to 1.76:1 ones) still gets its own shape, fitted inside the stage and centred
const frameRatio = (s: (typeof shots)[number]) => (s.tall || Math.abs(ratio(s) / shot - 1) < 0.05 ? shot : ratio(s));
const matVars = [`--shot: ${shot.toFixed(4)}`, ...shots.map((s, j) => `--r${j + 1}: ${frameRatio(s).toFixed(4)}`)].join('; ');
// an embedded quote's blockquote needs an id (the provider's script finds it by id to remove it once
// its iframe is ready) and an inline width (the script copies the inline style onto the iframe)
const embeds = (app.quotes ?? []).map((q) => embedFor(app, q));
const embedScripts = [...new Set(embeds.flatMap((e) => (e && 'script' in e ? [e.script] : [])))];
---

<Base title={app.name} description={app.tagline}>
  <SiteHeader home={pageHref(pageOf(app))}>
    <nav class="pager around" aria-label="previous and next app">
      {newer ? <a rel="prev" href={`/apps/${newer.id}/`} title={newer.name}>‹ newer</a> : <span class="off">‹ newest</span>}
      <b>{(app.index + 1).toLocaleString('en')} of {total.toLocaleString('en')}</b>
      {older ? <a rel="next" href={`/apps/${older.id}/`} title={older.name}>older ›</a> : <span class="off">first ever ›</span>}
    </nav>
  </SiteHeader>

  <main class:list={['detail', { bare: !shots.length }]}>
    <div class="hero">
      {shots.length ? (
        <div class="mat" style={matVars}>
          {app.hidden && <i class="draft">hidden</i>}
          {shots.map((s, j) => (
            <input
              class:list={['pick', { tall: s.tall, bare: s.bezel, panel: s.panel }]}
              type="radio"
              name="shot"
              id={pickId(j)}
              checked={j === 0}
              aria-label={`screenshot ${j + 1} of ${shots.length}`}
            />
          ))}
          <div class="stage">
            <a class="frame" href={app.url}>
              <span class="bar"><i></i><i></i><i></i><em>{host(app)}</em></span>
              <span class="screen">
                {shots.map((s, j) => <Image class="cover" src={s.image} alt={s.alt} loading={j === 0 ? 'eager' : 'lazy'} />)}
              </span>
            </a>
          </div>
          <div class="below">
            <div class="caps">
              {shots.map((s, j) => (
                <p class="cap">{many && <><b>{j + 1} of {shots.length}</b> · </>}{s.caption}</p>
              ))}
            </div>
            {many && (
              <div class="thumbs">
                {shots.map((s, j) => (
                  <label for={pickId(j)} class:list={{ tall: s.tall, bare: s.bezel }} style={!s.tall && `--r: ${frameRatio(s).toFixed(4)}`}>
                    <Image class="cover" src={s.image} alt="" width={200} />
                  </label>
                ))}
              </div>
            )}
            <span class="visits">{buttons.map((b) => <a class="visit" href={b.href}>{b.label}</a>)}</span>
          </div>
        </div>
      ) : (
        <div class="noshot">
          {app.hidden && <i class="draft">hidden</i>}
          <i class="tape"></i>
          <p>no picture yet.</p>
          <p>go and look at the real thing ↓</p>
          <span class="visits">{buttons.map((b) => <a class="visit" href={b.href}>{b.label}</a>)}</span>
        </div>
      )}
      <aside class="why"><i class="tape"></i><h2>curator’s note</h2><p>{app.why}</p></aside>
    </div>

    <article class="label">
      <p class="date">{fmtCreated(app.created)} · {app.form_factor.join(', ')}</p>
      <h1>{nameParts(app.name).map((part, i) => <>{i > 0 && <wbr />}{part}</>)}</h1>
      <p class="maker">
        {app.by.map((p, i) => (
          <>{i > 0 && ' & '}{p.url ? <a href={p.url}>{p.name}</a> : p.name}</>
        ))}
      </p>
      <p class="tagline">{app.tagline}</p>
      {app.quotes?.length ? (
        <section>
          <h2>maker’s words</h2>
          {app.quotes.map((q, i) => {
            const e = embeds[i];
            if (e && 'iframe' in e)
              return <iframe class="video" src={e.iframe} title={q.text} loading="lazy" allow="fullscreen; picture-in-picture" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>;
            const post = e && 'script' in e ? e : undefined;
            return (
              <blockquote class={post?.cls} id={post && `embed-${i + 1}`} style={post && 'width: 100%; max-width: 540px'} {...post?.attrs}>
                {q.text.trim().split(/\n+/).map((line) => <p>{line}</p>)}
                <footer>{q.by ?? app.by[0].name}{q.date && `, ${fmtDate(q.date)}`} · <a href={q.url}>source</a></footer>
              </blockquote>
            );
          })}
        </section>
      ) : null}
      {app.recs?.length ? (
        <section class="recs">
          <h2>recs</h2>
          <ul>
            {app.recs.map((r) => (
              <li><a href={r.url}>{r.title}</a>{r.by && ` · ${r.by}`}{r.date && ` (${fmtDate(r.date)})`}</li>
            ))}
          </ul>
        </section>
      ) : null}
      {also.length ? (
        <p class="links">also: {also.map((l, i) => <>{i > 0 && ' · '}<a href={l.url}>{l.label} ↗</a></>)}</p>
      ) : null}
      <p class="credit">collected by {app.curator.name}{app.submitted_by && <><br />suggested by {app.submitted_by.url ? <a href={app.submitted_by.url}>{app.submitted_by.name}</a> : app.submitted_by.name}</>}<br />no. {app.accession}</p>
    </article>
  </main>
  <SiteFooter />

  {embedScripts.length > 0 && (
    <script is:inline define:vars={{ embedScripts }}>
      /* post embeds only from 616px (38.5rem) up: below that the label squeezes the card under
         its 540px and the Threads header overlaps itself, so the quote stays as text */
      if (matchMedia('(min-width: 38.5rem)').matches)
        for (const src of embedScripts) document.body.append(Object.assign(document.createElement('script'), { src, async: true }));
    </script>
  )}
  {many && (
    <script is:inline>
      /* left / right arrows page through the screenshots (the thumbnails work without this) */
      addEventListener('keydown', (e) => {
        if ((e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') || e.metaKey || e.ctrlKey || e.altKey) return;
        const picks = [...document.querySelectorAll('.pick')];
        e.preventDefault();
        const i = picks.findIndex((p) => p.checked) + (e.key === 'ArrowRight' ? 1 : -1);
        picks[(i + picks.length) % picks.length].checked = true;
      });
    </script>
  )}
</Base>
