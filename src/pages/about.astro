---
// The origin story, in the original home page's design: a window, an admission ticket, the motto
// on a sticky note, a postcard tucked under the window as the way to the suggestion box, and the maker's rubber stamp
// at the foot. The words come from src/content/site.yaml. Design record: .claude/FORM.md → About page.
import Base from '../layouts/Base.astro';
import Doodles from '../components/Doodles.astro';
import { getApps } from '../lib/apps';
import { getSite } from '../lib/site';

const apps = await getApps();
const site = await getSite();
// "{apps}" in the status becomes "43 apps", linked to the index
const [before, after] = site.status.split('{apps}');
// the rubber stamp at the foot: "made by vivian" over "vivqu.com", linking there
const by = site.by;
const byHost = by.url ? new URL(by.url).hostname.replace(/^www\./, '') : undefined;
---

<Base title="about" description={site.lede} class="s-about">
  <main class="about">
    <div class="frame">
      <Doodles />
      {site.suggest?.endpoint && (
        <>
          {/* the way to the suggestion box: its own object, a small postcard tucked under the window's right edge */}
          <a class="minicard" href="/suggest/" aria-label="suggest an app">
            <em>post card</em>
            <span class="mstamp" aria-hidden="true"><svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><circle cx="20" cy="20" r="6.5" /><path d="M20 4v5M20 31v5M4 20h5M31 20h5M8.7 8.7l3.5 3.5M27.8 27.8l3.5 3.5M8.7 31.3l3.5-3.5M27.8 12.2l3.5-3.5" /></svg></span>
            <span class="line"></span><span class="rule r1"></span><span class="rule r2"></span><span class="rule r3"></span>
          </a>
          <span class="minilabel" aria-hidden="true"><svg class="arrow" viewBox="0 0 60 80" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M8 76c22-8 30-30 26-66" /><path d="M24 20l10-12 8 13" /></svg> suggest an app</span>
        </>
      )}
      <section class="window">
        <header class="titlebar">
          <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="name">weirdlittleapps.com/about</span>
        </header>
        <div class="content">
          <h1><a href="/">weird <em>little</em> apps</a></h1>
          <p class="eyebrow">{site.subtitle} <span class="nowrap">· est. {site.established}</span></p>
          <p class="lede">{site.lede}</p>
          <dl class="now">
            <dt>status</dt>
            <dd class="cursor">{before}{after !== undefined && <a href="/">{apps.length.toLocaleString('en')} apps</a>}{after}</dd>
            {site.next && <><dt>next</dt><dd>{site.next}</dd></>}
          </dl>
        </div>
      </section>
      <span class="sticker new" aria-hidden="true"><span class="face">admission free<span class="star">✶</span></span></span>
    </div>
    <footer class="note">
      <span class="tape" aria-hidden="true"></span>
      <p class="motto"><q>{site.motto}</q><a class="wavy" href={site.post}>read the post</a></p>
    </footer>
    {by.url && <a class="inkstamp" href={by.url}><span>made by {by.short ?? by.name}</span><b>{byHost}</b></a>}
  </main>
</Base>
