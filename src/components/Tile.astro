---
// One tile on the screenshot wall: the cover in a mini window (or a drawn phone, or bare, as the
// capture requires), then name, tagline and maker.
import { Image } from 'astro:assets';
import { domain, makers, nameParts, type App } from '../lib/apps';

interface Props {
  app: App;
}
const { app } = Astro.props;
const shot = app.shots[0];
// hand-placed: each phone leans its own way, picked from the app's id so it keeps its lean wherever it lands on the wall
const TILTS = [2, -2.5, 3.5, -1.5, 2.5, -3, 1.5, -2];
const tilt = TILTS[[...app.id].reduce((h, c) => (h * 31 + c.charCodeAt(0)) % 9973, 7) % TILTS.length];
---

<li class:list={{ hidden: app.hidden }}>
  <a href={`/apps/${app.id}/`}>
    {app.hidden && !shot?.tall && <i class="draft">hidden</i>}
    {shot?.tall ? (
      <span class="phonebox">
        <span class:list={['phone', { bare: shot.bezel, panel: shot.panel }]} style={`--tilt: ${tilt}deg`}>
          <Image class="cover" src={shot.image} alt={shot.alt} width={320} />
        </span>
        {app.hidden && <i class="draft">hidden</i>}
      </span>
    ) : (
      <span class="miniwin">
        <span class="bar"><i></i><i></i><i></i><em>{domain(app)}</em></span>
        {shot ? (
          <Image class="cover" src={shot.image} alt={shot.alt} width={720} />
        ) : (
          <span class="cover none" role="img" aria-label="no picture yet"><span>no picture yet</span></span>
        )}
      </span>
    )}
    <span class="name">{nameParts(app.name).map((part, i) => <>{i > 0 && <wbr />}{part}</>)}</span>
    <span class="tagline">{app.tagline}</span>
    <span class="who">by {makers(app)}</span>
  </a>
</li>
