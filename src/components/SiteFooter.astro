---
// The way to the origin story, the suggestion box and the feed, on every page but about.
import { getSite } from '../lib/site';
const site = await getSite();
---

{/* each dot stays with the word before it, so a narrow screen breaks the line between words, never before a dot */}
<footer class="site"><span class="nowrap">est. {site.established} <span aria-hidden="true">·</span></span> <span class="nowrap"><a href="/about/">about</a> <span aria-hidden="true">·</span></span> {site.suggest?.endpoint && <><span class="nowrap"><a href="/suggest/">suggest an app</a> <span aria-hidden="true">·</span></span> </>}<a href="/feed.xml">rss</a></footer>
